{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=BookVerseDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "BookVerse_Super_Secret_Key_For_Senior_Clean_Architecture_2026!",
    "Issuer": "BookVerse.Api",
    "Audience": "BookVerse.Client",
    "ExpirationMinutes": 120
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/bookverse-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}